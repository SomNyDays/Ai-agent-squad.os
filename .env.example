NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use one publishable/anon key. The app supports all three names below.
# Current Supabase publishable-key option:
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Alternative names, including legacy anon keys:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only privileged key. Set ONE of the following, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy alternative:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET

# Server-only AI provider secret. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional server-side model override.
OPENAI_MODEL=gpt-4.1-mini
